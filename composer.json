{
  "name": "zendrop/laravel-jwt",
  "type": "library",
  "require": {
    "firebase/php-jwt": "^6.8|^7.0",
    "laravel/framework": "^12|^13"
  },
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Zendrop\\LaravelJwt\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Zendrop\\LaravelJwt\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Igor Filippov",
      "email": "thisfil@ya.ru"
    }
  ],
  "extra": {
    "laravel": {
      "providers": [
        "Zendrop\\LaravelJwt\\LaravelJwtServiceProvider"
      ]
    }
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "laravel/pint": "^1.13",
    "squizlabs/php_codesniffer": "^3.7",
    "slevomat/coding-standard": "^8.14",
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.3|^12.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "policy": {
      "advisories": {
        "ignore-id": [
          "PKSA-y2cr-5h3j-g3ys"
        ]
      }
    }
  }
}
